{
  "id": "hammer_curl",
  "name": "Hammer Curl",
  "aliases": [
    "neutral grip curl",
    "db hammer curl"
  ],
  "family": "elbow_flexion",
  "movement_patterns": [
    "curl",
    "flexion"
  ],
  "target_muscles": [
    "biceps",
    "brachialis"
  ],
  "secondary_muscles": [
    "forearms"
  ],
  "primary_joints": [
    "elbow"
  ],
  "equipment": [
