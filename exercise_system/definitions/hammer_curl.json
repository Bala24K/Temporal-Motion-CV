    "full_body": false,
    "notes": "Best at about 45 degrees. From straight on, the forearm moves toward the camera, so do the range capture first."
  },
  "required_joints": [
    "left_shoulder",
    "right_shoulder",
    "left_elbow",
    "right_elbow",
    "left_wrist",
    "right_wrist",
    "left_hip",
    "right_hip"
  ],
  "rep": {
    "signal": {
      "primitive": "joint_angle",
      "joints": [
        "shoulder",
        "elbow",
        "wrist"
      ],
      "side": "visible"
    },
    "rest": 170,
    "peak": 45,
    "toward_peak_phase": "concentric",
    "population_range": {
      "rest": [
        135,
        180
      ],
      "peak": [
        25,
        105
      ]
    }
  },
  "form_rules": [
    {
      "id": "rom",
      "type": "rom",
      "min": 0.85,
      "max": null,
      "severity": "warn",
      "good": "Full curl",
      "bad": "Curl all the way up"
    },
    {
      "id": "tempo",
      "type": "tempo",
      "min_phase_seconds": 0.6,
      "severity": "warn",
      "good": "Controlled tempo",
      "bad": "Slow down - control both halves of the rep"
    },
    {
      "id": "elbow_pinned",
      "type": "stability",
      "signal": {
        "primitive": "segment_vertical_angle",
        "joints": [
          "shoulder",
          "elbow"
        ],
        "side": "visible"
      },
      "max": 18,
      "severity": "warn",
      "good": "Elbows stay pinned",
      "bad": "Keep your elbows by your sides"
    },
    {
      "id": "torso_steady",
      "type": "limit",
      "signal": {
        "primitive": "trunk_lean"
      },
      "max": 12,
      "min": null,
      "severity": "warn",
      "good": "Torso steady",
      "bad": "Don't swing your torso"
    },
    {
      "id": "arm_sync",
      "type": "symmetry",
      "signal": {
        "primitive": "joint_angle",
        "joints": [
          "shoulder",
          "elbow",
