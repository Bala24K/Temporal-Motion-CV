      },
      "max": 15,
      "severity": "warn",
      "good": "Arms in sync",
      "bad": "Arms are uneven",
      "views": [
        "front",
        "45deg"
      ]
    }
  ],
  "posture": [
    {
      "signal": {
        "primitive": "segment_vertical_angle",
        "joints": [
